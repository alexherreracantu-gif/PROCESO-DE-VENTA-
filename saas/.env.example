# Copia este archivo como .env.local y llena los valores de tu proyecto de Supabase
# (Supabase → Project Settings → API y → Database → Connection string).

# Públicas: se usan en el navegador
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Secretas: solo en el servidor (nunca las compartas)
SUPABASE_SERVICE_ROLE_KEY=
# Solo para `npm run setup` (crear tablas, catálogo y usuarios). No hace falta en Vercel.
DATABASE_URL=postgresql://postgres.TU-PROYECTO:TU-CONTRASEÑA@aws-0-us-east-1.pooler.supabase.com:5432/postgres

# Opcional: activa el Agente IA (console.anthropic.com → API Keys)
ANTHROPIC_API_KEY=
# …o con ChatGPT (platform.openai.com → API keys). Si están las dos, usa Claude.
OPENAI_API_KEY=

# Opcional: landing de flotillas (/flotillas)
AVISO_PRIVACIDAD_URL=
CALENDLY_URL=
# WhatsApp automático (Meta → WhatsApp Business Platform). Plantillas en el README.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_PLANTILLA_FLOTILLA=
WHATSAPP_PLANTILLA_ASESOR=
# Seguimiento días 1, 3, 7 y 14 (las 4 plantillas en orden) y aviso al asesor cuando el cliente contesta
WHATSAPP_SEGUIMIENTO=
WHATSAPP_PLANTILLA_RESPUESTA=
# Webhook de Meta (/api/whatsapp/webhook): token que tú inventas y clave secreta de la app
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# Opcional: resumen diario y reporte semanal (lunes) por correo con resend.com
RESEND_API_KEY=
CRON_SECRET=
# RESUMEN_REMITENTE=Park Point <avisos@tudominio.com>
# Reporte semanal también por WhatsApp: plantilla aprobada y usuarios que lo pidieron (ej. alex,jorge)
WHATSAPP_PLANTILLA_REPORTE=
REPORTE_WHATSAPP=

# WHATSAPP_IDIOMA=es_MX
# WHATSAPP_API_VERSION=v23.0
# SITIO_URL=https://park-point-two.vercel.app
